# Bu faylni .env nomi bilan nusxalang va qiymatlarni to'ldiring:
#   cp .env.example .env
# .env fayli HECH QACHON git'ga qo'shilmasin (.gitignore da bloklangan).
# Railway'da bu qiymatlar Variables bo'limiga kiritiladi.
# ============================================================
# MAJBURIY
# ============================================================
# @BotFather dan olinadi
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# ============================================================
# ADMINLAR
# ============================================================

# Bu yerda ko'rsatilgan HAR BIR foydalanuvchi avtomatik SUPER ADMIN bo'ladi.
# ID ni @userinfobot dan bilib olish mumkin.
#
# Quyidagi formatlarning hammasi ishlaydi:
#   ADMIN_ID=[]                          -> hech kim (parol bilan kiriladi)
#   ADMIN_ID=637554472                   -> bitta super admin
#   ADMIN_ID=[637554472, 123456789]      -> ikkita super admin
#   ADMIN_ID=637554472,123456789         -> xuddi shunday
#
# Bo'sh qoldirilsa — parolni birinchi bo'lib to'g'ri kiritgan odam super admin bo'ladi.
ADMIN_ID=[]
# Admin paneliga kirish uchun BOSHLANG'ICH parol.
# Faqat baza bo'sh bo'lganda ishlatiladi; keyin super admin uni panel orqali almashtiradi.
ADMIN_PASSWORD=1234567890
# ============================================================
# KLINIKA
# ============================================================

TIMEZONE=Asia/Tashkent

# Manzil va xarita — FAQAT birinchi ishga tushish uchun boshlang'ich qiymat.
# Keyinchalik super admin ularni bot ichidan o'zgartiradi:
#   /admin -> ⚙️ Sozlamalar -> 📍 Klinika ma'lumotlari
# Ish soatlari, bo'limlar va navbat qoidalari ham o'sha yerdan boshqariladi —
# ular umuman .env da yo'q.
CLINIC_ADDRESS=Toshkent sh., Stomatologiya klinikasi
MAP_LINK=https://maps.app.goo.gl/Ay8YVsm44MMAWxst9?g_st=ac


# ============================================================
# MA'LUMOTLAR FAYLI
# ============================================================

# Lokalda ishlatganda shunday qoldiring:
DATA_FILE=data.json

# Railway'da esa Volume ulangan papkani ko'rsating, aks holda
# har redeploy'da BARCHA ma'lumot yo'qoladi:
#   DATA_FILE=/data/data.json


# ============================================================
# GITHUB ZAXIRASI (Railway uchun tavsiya etiladi)
# ============================================================
#
# Railway konteynerida disk vaqtinchalik. Volume ulanmagan bo'lsa yoki
# qo'shimcha xavfsizlik uchun — data.json davriy ravishda GitHub'ga yuklanadi,
# bot ishga tushganda esa baza bo'sh bo'lsa, o'sha zaxiradan tiklanadi.
#
# ⚠️ ZAXIRA REPOZITORIYASI FAQAT PRIVATE BO'LISHI KERAK!
#    Ichida bemorlarning ismi va telefon raqami bo'ladi.
#    Bot public repo'ni aniqlasa, zaxiralashni o'zi o'chiradi.
#
# Sozlash:
#   1. GitHub'da YANGI PRIVATE repozitoriy yarating (masalan: navbat-backup)
#   2. Token oling: github.com/settings/personal-access-tokens
#      - Repository access: faqat o'sha repo
#      - Permissions -> Contents: Read and write
#   3. Quyidagi qiymatlarni to'ldiring

# Bo'sh qoldirilsa, zaxiralash o'chiq turadi
BACKUP_REPO=
BACKUP_TOKEN=

# Ixtiyoriy
BACKUP_BRANCH=main
BACKUP_FILE=backup/data.json
BACKUP_INTERVAL_MINUTES=5

# Bu fayldan nusxa oling:  cp .env.example .env
# .env fayli git'ga TUSHMAYDI (.gitignore da bloklangan) — shunday qolsin.
# Railway'da bu qiymatlar Variables bo'limiga kiritiladi.

# ============================================================
# 1) MAJBURIY — BU YERNI TO'LDIRING
# ============================================================
# @BotFather dan olingan token. Pastdagi qiymatni almashtiring:
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA


# ============================================================
# 2) ADMINLAR
# ============================================================
# Bu yerdagi HAR BIR ID avtomatik super admin bo'ladi (@userinfobot dan biling).
#   ADMIN_ID=[]                       -> hech kim, parol bilan kiriladi
#   ADMIN_ID=[637554472]              -> bitta super admin
#   ADMIN_ID=[637554472, 123456789]   -> ikkita
ADMIN_ID=[]

# Panelga kirish uchun boshlang'ich parol (keyin panelda almashtiriladi)
ADMIN_PASSWORD=1234567890


# ============================================================
# 3) KLINIKA (faqat birinchi ishga tushish uchun)
# ============================================================
# Keyin hammasi bot ichidan: /admin -> ⚙️ Sozlamalar
TIMEZONE=Asia/Tashkent
CLINIC_ADDRESS=Toshkent sh., Stomatologiya klinikasi
MAP_LINK=https://maps.app.goo.gl/Ay8YVsm44MMAWxst9?g_st=ac


# ============================================================
# 4) MA'LUMOTLAR FAYLI
# ============================================================
# Lokalda:
DATA_FILE=data.json
# Railway'da (Volume /data ga ulangandan keyin) shuni qo'ying:
#   DATA_FILE=/data/data.json


# ============================================================
# 5) GITHUB ZAXIRASI — yangi serverda ma'lumot yo'qolmasligi uchun
# ============================================================
# Zaxira ALOHIDA 'backup' shoxiga yoziladi.
#
# Nega 'main' emas? Railway 'main' ga har push'da qayta deploy qiladi.
# Zaxira ham 'main' ga yozilsa: zaxira -> deploy -> bot qayta ishga tushadi ->
# yana zaxira -> cheksiz sikl. 'backup' shoxi buni butunlay oldini oladi.
# Shox mavjud bo'lmasa, bot uni o'zi yaratadi.
BACKUP_REPO=foydalanuvchi/repo
BACKUP_BRANCH=backup
BACKUP_FILE=backup/data.json
BACKUP_INTERVAL_MINUTES=5

# ⬇️ TO'LDIRING: GitHub Personal Access Token
#    github.com/settings/personal-access-tokens -> Generate new token
#    Repository access : Only select repositories -> Bot_navbat
#    Permissions       : Contents -> Read and write
BACKUP_TOKEN=

# 🔒 SHIFRLASH KALITI.
#    PUBLIC repozitoriyga zaxiralasangiz — MAJBURIY:
#    zaxira shu kalit bilan shifrlanadi va GitHub'da o'qib bo'lmaydigan
#    holda turadi (bemorlarning ismi ham, telefoni ham ko'rinmaydi).
#
#    ⚠️ BU KALITNI YO'QOTMANG! Yo'qolsa, zaxirani hech kim ocholmaydi.
#       Nusxasini boshqa xavfsiz joyga ham saqlab qo'ying.
BACKUP_ENCRYPT_KEY=
#
#    Kalit yaratish:
#      python -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(48)))"

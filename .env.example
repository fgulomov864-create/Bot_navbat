# Bu fayldan nusxa oling:  cp .env.example .env
# .env fayli git'ga TUSHMAYDI (.gitignore da bloklangan) — shunday qolsin.
# Railway'da bu qiymatlar Variables bo'limiga kiritiladi.
#
# Qadamma-qadam qo'llanma: DEPLOY.md
# Tekshirish:              python check.py

# ============================================================
# 1) MAJBURIY
# ============================================================

# @BotFather dan olingan token
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA


# ============================================================
# 2) ADMINLAR
# ============================================================

# ⚠️ Bu yerga BOTNING emas, O'ZINGIZNING Telegram ID'ingiz kerak.
#    ID ni @userinfobot ga /start yozib bilib olasiz.
#    (Botning ID'si token boshidagi raqam bilan bir xil — u BO'LMASIN.)
#
# Bu yerdagi HAR BIR ID avtomatik SUPER ADMIN bo'ladi:
#   ADMIN_ID=[]                       -> hech kim, parol bilan kiriladi
#   ADMIN_ID=[123456789]              -> bitta super admin
#   ADMIN_ID=[123456789, 987654321]   -> ikkita
#
# Bo'sh qoldirilsa — parolni birinchi to'g'ri kiritgan odam super admin bo'ladi.
ADMIN_ID=[]

# Panelga kirish uchun boshlang'ich parol (keyin panelda almashtiriladi)
ADMIN_PASSWORD=1234567890


# ============================================================
# 3) KLINIKA (faqat birinchi ishga tushish uchun)
# ============================================================
# Keyin hammasi bot ichidan: /admin -> ⚙️ Sozlamalar
# Ish soatlari, bo'limlar va navbat qoidalari umuman .env da yo'q —
# ular ham o'sha yerdan boshqariladi.

TIMEZONE=Asia/Tashkent
CLINIC_ADDRESS=Toshkent sh., Stomatologiya klinikasi
MAP_LINK=https://maps.app.goo.gl/Ay8YVsm44MMAWxst9?g_st=ac


# ============================================================
# 4) MA'LUMOTLAR FAYLI
# ============================================================

# Lokalda:
DATA_FILE=data.json

# Railway'da (Volume /data ga ulangandan keyin) shuni qo'ying,
# aks holda har redeploy'da BARCHA ma'lumot yo'qoladi:
#   DATA_FILE=/data/data.json


# ============================================================
# 5) GITHUB ZAXIRASI — yangi serverda ma'lumot yo'qolmasligi uchun
# ============================================================
#
# Bot ishga tushganda lokal fayl va zaxirani solishtiradi — 'revision'
# raqami kattarog'i yutadi. Shu tufayli butunlay yangi serverga
# qo'yilganda ham hamma bemor, navbat va sozlama qaytadi.
#
# Token olish:
#   github.com/settings/personal-access-tokens -> Generate new token
#   Repository access : Only select repositories -> kerakli repo
#   Permissions       : Contents -> Read and write
#
# Bo'sh qoldirilsa, zaxiralash o'chiq turadi.

BACKUP_REPO=
BACKUP_TOKEN=

# ⚠️ ASOSIY SHOX (main) BO'LMASIN!
#    Railway 'main' ga har push'da qayta deploy qiladi. Zaxira ham o'sha
#    yerga yozilsa: zaxira -> deploy -> bot qayta ishga tushadi -> yana
#    zaxira -> cheksiz sikl. Shox mavjud bo'lmasa, bot uni o'zi yaratadi.
BACKUP_BRANCH=backup

BACKUP_FILE=backup/data.json
BACKUP_INTERVAL_MINUTES=5

# 🔒 SHIFRLASH KALITI
#    PUBLIC repozitoriyga zaxiralasangiz — MAJBURIY. Kalitsiz bot public
#    repo'ga yozishdan bosh tortadi, chunki zaxirada bemorlarning ismi va
#    telefon raqami bo'ladi.
#
#    Kalit yaratish:
#      python -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(48)))"
#
#    ⚠️ KALITNI YO'QOTMANG! Yo'qolsa, zaxirani hech kim ocholmaydi.
#       Ochish: python backup.py --decrypt backup.enc data.json
BACKUP_ENCRYPT_KEY=
